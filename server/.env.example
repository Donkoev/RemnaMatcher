# mock — работа на сгенерированных данных без панели; live — боевой режим
MODE=mock
PORT=3300

# --- Боевой режим (MODE=live) ---
# URL панели, например https://panel.example.com
REMNAWAVE_URL=
# API-токен из панели (Настройки -> API-токены). Лучше завести отдельный токен под RemnaMatcher.
REMNAWAVE_TOKEN=
# Секрет nginx-защиты панели в формате key=value (если панель прикрыта секретом). Пусто — не используется.
REMNAWAVE_SECRET=

# Токен ipinfo.io для точных городов (бесплатный: https://ipinfo.io/signup)
IPINFO_TOKEN=

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Твой chat id (напиши боту /start — он его покажет)
TELEGRAM_ADMIN_CHAT_ID=

# Периоды опроса/синка и хранение данных правятся в панели: Настройки -> Сбор данных

# --- Пути ---
DB_PATH=./data/remnamatcher.db
GEOIP_CITY_MMDB=./data/dbip-city-lite.mmdb
GEOIP_ASN_MMDB=./data/dbip-asn-lite.mmdb
