# --- Режим ---
MODE=mock                                    # mock — сгенерированные данные без панели; live — боевой режим
PORT=3300                                    # порт веб-панели и API

# --- Remnawave (для MODE=live) ---
REMNAWAVE_URL=                               # URL панели, например https://panel.example.com (без слэша на конце)
REMNAWAVE_TOKEN=                             # API-токен из панели (лучше отдельный под RemnaMatcher — легко отозвать)
REMNAWAVE_SECRET=                            # секрет nginx-защиты панели key=value, если она есть; пусто — не используется

# --- Сервисы ---
IPINFO_TOKEN=                                # токен ipinfo.io для точных городов (бесплатно: https://ipinfo.io/signup)

# --- Telegram ---
TELEGRAM_BOT_TOKEN=                          # токен бота от @BotFather
TELEGRAM_ADMIN_CHAT_ID=                      # твой chat id (напиши боту /start — он покажет)

# Периоды опроса/синка и хранение данных правятся в панели: Настройки -> Сбор данных

# --- Пути ---
DB_PATH=./data/remnamatcher.db               # база SQLite
GEOIP_CITY_MMDB=./data/dbip-city-lite.mmdb   # гео-база городов (npm run -w server geoip)
GEOIP_ASN_MMDB=./data/dbip-asn-lite.mmdb     # гео-база ASN
